{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "saiadf24"
		},
		"ls_azuresql_source_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'ls_azuresql_source'"
		},
		"ls_azuresql_target_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'ls_azuresql_target'"
		},
		"ls_azuresql_source_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sqlserverfeb24.database.windows.net"
		},
		"ls_azuresql_source_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "source"
		},
		"ls_azuresql_source_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "sai"
		},
		"ls_azuresql_target_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sqlserverfeb24.database.windows.net"
		},
		"ls_azuresql_target_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "target"
		},
		"ls_azuresql_target_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "sai"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/ls_azuresql_source')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureSqlDatabase",
				"typeProperties": {
					"server": "[parameters('ls_azuresql_source_properties_typeProperties_server')]",
					"database": "[parameters('ls_azuresql_source_properties_typeProperties_database')]",
					"encrypt": "mandatory",
					"trustServerCertificate": true,
					"authenticationType": "SQL",
					"userName": "[parameters('ls_azuresql_source_properties_typeProperties_userName')]",
					"password": {
						"type": "SecureString",
						"value": "[parameters('ls_azuresql_source_password')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/ls_azuresql_target')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureSqlDatabase",
				"typeProperties": {
					"server": "[parameters('ls_azuresql_target_properties_typeProperties_server')]",
					"database": "[parameters('ls_azuresql_target_properties_typeProperties_database')]",
					"encrypt": "mandatory",
					"trustServerCertificate": true,
					"authenticationType": "SQL",
					"userName": "[parameters('ls_azuresql_target_properties_typeProperties_userName')]",
					"password": {
						"type": "SecureString",
						"value": "[parameters('ls_azuresql_target_password')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/scdtype1')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"linkedService": {
								"referenceName": "ls_azuresql_source",
								"type": "LinkedServiceReference"
							},
							"name": "srcCust"
						},
						{
							"linkedService": {
								"referenceName": "ls_azuresql_target",
								"type": "LinkedServiceReference"
							},
							"name": "trgtcust"
						}
					],
					"sinks": [
						{
							"linkedService": {
								"referenceName": "ls_azuresql_target",
								"type": "LinkedServiceReference"
							},
							"name": "sink1"
						},
						{
							"linkedService": {
								"referenceName": "ls_azuresql_target",
								"type": "LinkedServiceReference"
							},
							"name": "sink2"
						}
					],
					"transformations": [
						{
							"name": "srcSelect"
						},
						{
							"name": "trgtSelect"
						},
						{
							"name": "Doesntexist"
						},
						{
							"name": "derivedColumn1"
						},
						{
							"name": "select1"
						},
						{
							"name": "lookup1"
						},
						{
							"name": "filter1"
						},
						{
							"name": "derivedColumn2"
						},
						{
							"name": "filter2"
						},
						{
							"name": "select2"
						},
						{
							"name": "alterRow1"
						}
					],
					"scriptLines": [
						"source(output(",
						"          CustomerID as integer,",
						"          CustName as string,",
						"          location as string,",
						"          sales as decimal(19,4)",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     format: 'query',",
						"     store: 'sqlserver',",
						"     query: 'select \\nCustomerID,\\nCustName,\\nlocation,\\nsales\\nfrom customer',",
						"     isolationLevel: 'READ_UNCOMMITTED') ~> srcCust",
						"source(output(",
						"          CustomerID as integer,",
						"          CustName as string,",
						"          location as string,",
						"          sales as decimal(19,4)",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     format: 'query',",
						"     store: 'sqlserver',",
						"     query: 'select \\nCustomerID,\\nCustName,\\nlocation,\\nsales\\nfrom customer',",
						"     isolationLevel: 'READ_UNCOMMITTED') ~> trgtcust",
						"srcCust select(mapColumn(",
						"          src_CustomerID = CustomerID,",
						"          src_CustName = CustName,",
						"          src_location = location,",
						"          src_sales = sales",
						"     ),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> srcSelect",
						"trgtcust select(mapColumn(",
						"          trg_CustomerID = CustomerID,",
						"          trg_CustName = CustName,",
						"          trg_location = location,",
						"          trg_sales = sales",
						"     ),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> trgtSelect",
						"srcSelect, trgtSelect exists(src_CustomerID == trg_CustomerID,",
						"     negate:true,",
						"     broadcast: 'auto')~> Doesntexist",
						"Doesntexist derive(Flag = 'Inserted') ~> derivedColumn1",
						"derivedColumn1 select(mapColumn(",
						"          CustomerID = src_CustomerID,",
						"          CustName = src_CustName,",
						"          location = src_location,",
						"          sales = src_sales,",
						"          Flag",
						"     ),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> select1",
						"srcSelect, trgtSelect lookup(src_CustomerID == trg_CustomerID,",
						"     multiple: false,",
						"     pickup: 'any',",
						"     broadcast: 'auto')~> lookup1",
						"lookup1 filter(not(isNull(trg_CustomerID))) ~> filter1",
						"filter1 derive(IsChangedRecrds = iif(src_CustomerID != trg_CustomerID || src_CustName != trg_CustName || src_location != trg_location || src_sales != trg_sales,'Yes','No'),",
						"          Flag = 'Updated') ~> derivedColumn2",
						"derivedColumn2 filter(IsChangedRecrds== 'Yes') ~> filter2",
						"filter2 select(mapColumn(",
						"          CustomerID = src_CustomerID,",
						"          CustName = src_CustName,",
						"          location = src_location,",
						"          sales = src_sales,",
						"          Flag",
						"     ),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> select2",
						"select2 alterRow(updateIf(1==1)) ~> alterRow1",
						"select1 sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     input(",
						"          CustomerID as integer,",
						"          CustName as string,",
						"          location as string,",
						"          sales as decimal(19,4),",
						"          flag as string",
						"     ),",
						"     format: 'table',",
						"     store: 'sqlserver',",
						"     schemaName: 'dbo',",
						"     tableName: 'customer',",
						"     insertable: true,",
						"     updateable: false,",
						"     deletable: false,",
						"     upsertable: false,",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError',",
						"     mapColumn(",
						"          CustomerID,",
						"          CustName,",
						"          location,",
						"          sales,",
						"          flag = Flag",
						"     )) ~> sink1",
						"alterRow1 sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     input(",
						"          CustomerID as integer,",
						"          CustName as string,",
						"          location as string,",
						"          sales as decimal(19,4),",
						"          flag as string",
						"     ),",
						"     format: 'table',",
						"     store: 'sqlserver',",
						"     schemaName: 'dbo',",
						"     tableName: 'customer',",
						"     insertable: false,",
						"     updateable: true,",
						"     deletable: false,",
						"     upsertable: false,",
						"     keys:['CustomerID'],",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError',",
						"     mapColumn(",
						"          CustomerID,",
						"          CustName,",
						"          location,",
						"          sales,",
						"          flag = Flag",
						"     )) ~> sink2"
					]
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/ls_azuresql_source')]",
				"[concat(variables('factoryId'), '/linkedServices/ls_azuresql_target')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/scdtype2')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"linkedService": {
								"referenceName": "ls_azuresql_source",
								"type": "LinkedServiceReference"
							},
							"name": "SrcCust"
						},
						{
							"linkedService": {
								"referenceName": "ls_azuresql_target",
								"type": "LinkedServiceReference"
							},
							"name": "TrgCust"
						}
					],
					"sinks": [
						{
							"linkedService": {
								"referenceName": "ls_azuresql_target",
								"type": "LinkedServiceReference"
							},
							"name": "sink1"
						},
						{
							"linkedService": {
								"referenceName": "ls_azuresql_target",
								"type": "LinkedServiceReference"
							},
							"name": "sink2"
						}
					],
					"transformations": [
						{
							"name": "SrcSelect"
						},
						{
							"name": "TrgSelect"
						},
						{
							"name": "lookup1"
						},
						{
							"name": "split1"
						},
						{
							"name": "select1"
						},
						{
							"name": "filter1"
						},
						{
							"name": "select2"
						},
						{
							"name": "union1"
						},
						{
							"name": "derivedColumn1"
						},
						{
							"name": "select3"
						},
						{
							"name": "derivedColumn2"
						},
						{
							"name": "alterRow1"
						}
					],
					"scriptLines": [
						"source(output(",
						"          CustomerID as integer,",
						"          CustName as string,",
						"          location as string,",
						"          sales as decimal(19,4)",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     format: 'query',",
						"     store: 'sqlserver',",
						"     query: 'select * from customer',",
						"     isolationLevel: 'READ_UNCOMMITTED') ~> SrcCust",
						"source(output(",
						"          CustomerKey as integer,",
						"          CustomerID as integer,",
						"          CustName as string,",
						"          location as string,",
						"          sales as decimal(19,4)",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     format: 'query',",
						"     store: 'sqlserver',",
						"     query: 'select CustomerKey ,\\nCustomerID ,\\nCustName ,\\nlocation ,\\nsales  from customer\\nwhere EndDate is null',",
						"     isolationLevel: 'READ_UNCOMMITTED') ~> TrgCust",
						"SrcCust select(mapColumn(",
						"          Src_CustomerID = CustomerID,",
						"          Src_CustName = CustName,",
						"          Src_location = location,",
						"          Src_sales = sales",
						"     ),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> SrcSelect",
						"TrgCust select(mapColumn(",
						"          CustomerKey,",
						"          Trg_CustomerID = CustomerID,",
						"          Trg_CustName = CustName,",
						"          Trg_location = location,",
						"          Trg_sales = sales",
						"     ),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> TrgSelect",
						"SrcSelect, TrgSelect lookup(Src_CustomerID == Trg_CustomerID,",
						"     multiple: false,",
						"     pickup: 'any',",
						"     broadcast: 'auto')~> lookup1",
						"lookup1 split(isNull(Trg_CustomerID),",
						"     disjoint: false) ~> split1@(NewRecords, ExistingRecords)",
						"split1@NewRecords select(mapColumn(",
						"          CustomerID = Src_CustomerID,",
						"          CustName = Src_CustName,",
						"          location = Src_location,",
						"          sales = Src_sales",
						"     ),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> select1",
						"split1@ExistingRecords filter(iif(Src_CustomerID!=Trg_CustomerID||Src_CustName!=Trg_CustName||Src_location!=Trg_location||Src_sales!=Trg_sales, true(), false())) ~> filter1",
						"filter1 select(mapColumn(",
						"          CustomerID = Src_CustomerID,",
						"          CustName = Src_CustName,",
						"          location = Src_location,",
						"          sales = Src_sales",
						"     ),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> select2",
						"select1, select2 union(byName: true)~> union1",
						"union1 derive(StartDate = currentUTC()) ~> derivedColumn1",
						"filter1 select(mapColumn(",
						"          CustomerKey",
						"     ),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> select3",
						"select3 derive(EndDate = currentUTC()) ~> derivedColumn2",
						"derivedColumn2 alterRow(updateIf(1==1)) ~> alterRow1",
						"derivedColumn1 sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     format: 'table',",
						"     store: 'sqlserver',",
						"     schemaName: 'dbo',",
						"     tableName: 'customer',",
						"     insertable: true,",
						"     updateable: false,",
						"     deletable: false,",
						"     upsertable: false,",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError') ~> sink1",
						"alterRow1 sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     format: 'table',",
						"     store: 'sqlserver',",
						"     schemaName: 'dbo',",
						"     tableName: 'customer',",
						"     insertable: false,",
						"     updateable: true,",
						"     deletable: false,",
						"     upsertable: false,",
						"     keys:['CustomerKey'],",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError') ~> sink2"
					]
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/ls_azuresql_source')]",
				"[concat(variables('factoryId'), '/linkedServices/ls_azuresql_target')]"
			]
		},
